<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF6FD"
    tools:context=".MenuActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#3A226D"
        android:paddingTop="8dp"
        android:text="Aplicacion Multimedia"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnCalculadora"
        android:layout_width="140dp"
        android:layout_height="65dp"
        android:layout_marginTop="200dp"
        android:backgroundTint="#3A226D"
        android:text="Calculadora"
        android:textColor="#FFFFFF"
        android:textColorLink="#B300FF"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/btnConversor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo" />

    <Button
        android:id="@+id/btnConversor"
        android:layout_width="140dp"
        android:layout_height="65dp"
        android:layout_marginTop="200dp"
        android:backgroundTint="#3A226D"
        android:text="Conversor"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnCalculadora"
        app:layout_constraintTop_toBottomOf="@+id/titulo" />

    <Button
        android:id="@+id/btnLista"
        android:layout_width="140dp"
        android:layout_height="65dp"
        android:backgroundTint="#3A226D"
        android:text="Mi lista"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnJuego"
        app:layout_constraintTop_toBottomOf="@+id/btnConversor" />

    <Button
        android:id="@+id/btnJuego"
        android:layout_width="140dp"
        android:layout_height="65dp"
        android:backgroundTint="#3A226D"
        android:text="Piedra, Papel, Tijera"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCalculadora" />
</androidx.constraintlayout.widget.ConstraintLayout>